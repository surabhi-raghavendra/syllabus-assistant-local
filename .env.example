# No API keys needed anywhere in this app -- everything runs locally.

# The Ollama model to use for text answers. Must already be pulled
# (run: ollama pull llama3). Other options: mistral, gemma2, etc.
OLLAMA_MODEL=llama3

# The URL where AUTOMATIC1111's Stable Diffusion WebUI API is running.
# Start it locally with the --api flag, e.g.:
#   ./webui.sh --api        (Mac/Linux)
#   webui-user.bat --api    (Windows)
SD_WEBUI_URL=http://127.0.0.1:7860

# Number of diffusion steps for image generation. Lower = faster, higher = better quality.
SD_STEPS=10
